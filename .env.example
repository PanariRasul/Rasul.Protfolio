# Copy this file to .env (local) or add these in Render → Environment.
# Everything is optional — the site works without any of them.

# ---------- AI chatbot (pick ONE, both have free tiers) ----------
# Google Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OR Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# ---------- Admin panel login (/admin) ----------
# Create a GitHub OAuth App: GitHub → Settings → Developer settings → OAuth Apps → New
#   Homepage URL:              https://YOUR-SITE.onrender.com
#   Authorization callback URL: https://YOUR-SITE.onrender.com/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your public site URL (recommended once you have a custom domain), no trailing slash
SITE_URL=

# ---------- Frontend (must start with VITE_, applied at build time) ----------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable)
VITE_GA_ID=
# Contact form key (already set in code; only change if you create a new one)
# VITE_WEB3FORMS_KEY=
# Visitor counter namespace (counterapi.dev)
# VITE_COUNTER_NAMESPACE=rasulpanari-portfolio
